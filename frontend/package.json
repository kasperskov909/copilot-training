{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project ../backend/Insurance.Api",
    "dev:web": "wait-on --timeout 60000 http-get://localhost:5037/api/health && vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
